{
  "manifest_version": 3,
  "name": "무브 · 퍼비드 블로그 도우미",
  "version": "1.4.0",
  "description": "사진과 메모에서 Codex로 블로그를 만들고 실제 사진과 원고를 네이버에 입력합니다.",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "action": {
    "default_title": "블로그 도우미 열기"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon.png"
  },
  "host_permissions": [
    "http://127.0.0.1:18764/*",
    "https://blog.naver.com/*"
  ],
  "key": ""
}